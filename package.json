{
  "name": "mhfrough",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/sitemap.mjs --source",
    "start": "ng serve --port 4300",
    "prebuild": "node scripts/sitemap.mjs --source",
    "build": "ng build && node scripts/postbuild.mjs",
    "prebuild:dev": "node scripts/sitemap.mjs --source",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:dist": "http-server dist/mhfrough/browser -p 4400 -c-1 --silent",
    "e2e": "playwright test",
    "lighthouse": "node scripts/lighthouse.mjs",
    "check:seo": "node scripts/postbuild.mjs --strict",
    "icons": "node scripts/icons.mjs",
    "og": "node scripts/og.mjs",
    "sitemap": "node scripts/sitemap.mjs",
    "about:photos": "node scripts/about-photos.mjs",
    "about:covers": "node scripts/hobby-covers.mjs",
    "e2e:report": "playwright show-report reports/playwright/html",
    "lighthouse:assert": "node scripts/lighthouse.mjs --assert",
    "qa": "npm run build && npm run e2e && npm run lighthouse:assert"
  },
  "private": true,
  "packageManager": "npm@10.9.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.12",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@ng-icons/core": "^33.4.0",
    "@ng-icons/phosphor-icons": "^33.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.12",
    "@angular/cli": "^21.2.12",
    "@angular/compiler-cli": "^21.2.0",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^20.17.19",
    "http-server": "^14.1.1",
    "jsdom": "^28.0.0",
    "lighthouse": "^12.8.2",
    "prettier": "^3.8.1",
    "sharp": "^0.35.5",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
