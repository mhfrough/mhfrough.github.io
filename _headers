# Cloudflare Pages / Netlify response headers. GitHub Pages ignores this file.
# scripts/postbuild.mjs replaces __INLINE_SCRIPT_HASHES__ in dist/.../_headers with the sha256 of every
# inline <script> Angular emits (event-replay contract + bootstrap) and the stylesheet onload handler.
# Always deploy the output of `npm run build` (ng build + postbuild), never raw `ng build` output.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-qOhFsq0QMV2REqNwk5hGH5bZE9SkX6gt6yeyKdYPv+U=' 'sha256-VM2mZqyEQZoLzoTrp5EigFvzQ0+f1wSeBuoOn95WHCg=' 'sha256-8sGKvDKC8crv9OBcqEMvqrNDWlm1/80h7NJpJzqOnLI=' 'sha256-VvjSuXS8BYEJcq+ZzRBAL6FxwukRP7mkl4UHHB9iX5A=' 'sha256-YR5UaeMJmcF2QvNpSDX5Em8xm7vOc4QqcnkdA1JMBlM=' 'sha256-eQxHdQTdVILkU0WaUq2agawcCeDRA33R2ar3RRl7nqw=' 'sha256-mj+XHgqjmhdsR/qHXHs5mRcb8A8Pg6wLtjNC/sFfeKk=' 'sha256-Jr5EY2cAkpsH7yZ3PP++SFUm0UXCh98Aw3AbV7SdJ/w=' 'sha256-jVB4Eyov/85Er4R+q5aC/zZZ3qaqCLo6MJxmo6XPDzo=' 'sha256-jzESFRJ+4/2Y5a6U8gyCEKyNTC8wAIFXljbZSNlLDSo=' 'sha256-DdEEADy7BEe/+ufRdR4K9DhwReT/lpZu/N/ieMf8IO0=' 'sha256-kgUsZrIYqCeI2bNfow1Z+0rs29JF9XGr3bIL7cT89Ss=' 'sha256-+yKH9IUgaI2JBmVf820Sy1YffXi/Pn7CVaEb+IFFkC0=' 'sha256-0ySMYBOajCisatqvRknOufJhm4vwD2PjY5Gz/wa1XiU=' 'sha256-e5xO1i9hpo9fPYzmFGbsk04/B3PjrbwU6z7SakSre+s=' 'sha256-Z4E4KwimjvxOQnPweI0vDvQXwqQrgv6yJm+NIKkQ1vE=' 'sha256-cE/29wWexT/0hJ9oRfhldxq4OwXLYRMETp4S3kyIsN8=' 'sha256-SvgUsDepba4LUCTjiDWeXvn1VFqO1Ry9qpGlEwRywD4=' 'sha256-LcJjulxvvIIloqnvU68vSQ5OtwANnZawzlsGzUmDQOM=' 'unsafe-hashes' 'sha256-MhtPZXr7+LpJUY5qtMutB+qWfQtMaPccfe7QXtCcEYc='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self' https://mhfrough.github.io; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; manifest-src 'self'; upgrade-insecure-requests

# Content-hashed bundles from Angular (outputHashing: all): cache forever.
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable
/media/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/media/*.woff
  Cache-Control: public, max-age=31536000, immutable

# Unhashed static assets: cache a day, revalidate after.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/og/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon.*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600

# HTML: no rule on purpose. Cloudflare Pages and Netlify already send
# "Cache-Control: public, max-age=0, must-revalidate" for HTML, so a deploy is visible immediately.
# Note: rules that match the same path merge (same header names get comma-joined), so keep
# Cache-Control patterns disjoint. public/media/<page>/ (videos, posters) is deliberately not immutable.
