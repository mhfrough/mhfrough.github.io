# Cloudflare Pages / Netlify response headers. GitHub Pages ignores this file.
# scripts/postbuild.mjs replaces __INLINE_SCRIPT_HASHES__ in dist/.../_headers with the sha256 of every
# inline <script> Angular emits (event-replay contract + bootstrap) and the stylesheet onload handler.
# Always deploy the output of `npm run build` (ng build + postbuild), never raw `ng build` output.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' __INLINE_SCRIPT_HASHES__; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self' https://mhfrough.github.io; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; manifest-src 'self'; upgrade-insecure-requests

# Content-hashed bundles from Angular (outputHashing: all): cache forever.
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable
/media/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/media/*.woff
  Cache-Control: public, max-age=31536000, immutable

# Unhashed static assets: cache a day, revalidate after.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/og/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon.*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600

# HTML: no rule on purpose. Cloudflare Pages and Netlify already send
# "Cache-Control: public, max-age=0, must-revalidate" for HTML, so a deploy is visible immediately.
# Note: rules that match the same path merge (same header names get comma-joined), so keep
# Cache-Control patterns disjoint. public/media/<page>/ (videos, posters) is deliberately not immutable.
